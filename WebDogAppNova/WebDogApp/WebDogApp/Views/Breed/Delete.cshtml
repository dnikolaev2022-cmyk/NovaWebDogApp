@model WebDogApp.Models.Breed.BreedVM

@{
    ViewData["Title"] = "Delete Breed";
}

<h1>Delete Breed</h1>

<h3>Are you sure you want to delete this breed?</h3>

<div asp-validation-summary="ModelOnly"
     class="text-danger"></div>

<dl class="row">

    <dt class="col-sm-2">
        Breed Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <input type="submit" value="Delete"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>