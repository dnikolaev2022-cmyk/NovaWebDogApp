@model WebDogApp.Models.Breed.BreedVM

@{
    ViewData["Title"] = "Breed Details";
}

<h1>Breed Details</h1>

<dl class="row">

    <dt class="col-sm-2">
        Id
    </dt>

    <dd class="col-sm-10">
        @Model.Id
    </dd>

    <dt class="col-sm-2">
        Breed Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>